# FastAPI Configuration
FASTAPI_ENV=development
DEBUG=true

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=PCAPassword123!

# n8n Webhook Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# OpenAI Configuration (for n8n workflows)
OPENAI_API_KEY=sk-...

# YouTube API Configuration (optional, for metadata fetching)
YOUTUBE_API_KEY=AIzaSy...

# Microsoft Graph Configuration (for Teams integration, used by n8n)
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
MICROSOFT_TENANT_ID=...

# Obsidian Vault Path (on home PC, used by n8n)
OBSIDIAN_VAULT_PATH=/path/to/vault

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,*
